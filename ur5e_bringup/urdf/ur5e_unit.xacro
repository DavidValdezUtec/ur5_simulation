<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <!--
    Macro que instancia un UR completo (cadena cinematica + ros2_control)
    y lo fija a un link padre existente. Pensado para poder llamarse varias
    veces desde un mismo xacro y así montar una celda con varios robots.

    name        : nombre único del robot (ej. "ur5e_1")
    tf_prefix   : prefijo de TF, normalmente "<name>_" para no chocar frames
    parent      : link al que se fija la base del robot (ej. "world")
    xyz / rpy   : pose del robot respecto a 'parent'
    ur_type     : modelo UR (ej. "ur5e", "ur5"), selecciona los yaml de
                  ur_description/config/<ur_type>/
    robot_ip    : IP del controlador real (ur_robot_driver). Ignorada si
                  use_fake_hardware=true o sim_ignition=true
    sim_ignition: simular en Gazebo (Ignition Fortress) con ign_ros2_control
                  en vez del driver real / mock. Excluyente con
                  use_fake_hardware (ambos meterian su plugin en <hardware>)
    simulation_controllers : ruta del yaml de controladores que recibe el
                  controller_manager que crea el plugin de Gazebo (solo se
                  usa con sim_ignition=true)
  -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />
  <xacro:include filename="$(find ur5e_bringup)/urdf/tool.urdf.xacro" />
  <xacro:include filename="$(find ur5e_bringup)/urdf/ur_sim.ros2_control.xacro" />

  <xacro:macro name="ur5e_unit" params="
      name
      tf_prefix
      parent
      xyz:='0 0 0'
      rpy:='0 0 0'
      ur_type:=ur5e
      robot_ip:=0.0.0.0
      use_fake_hardware:=true
      sim_ignition:=false
      simulation_controllers:=''
      headless_mode:=true
      safety_limits:=true
      safety_pos_margin:=0.15
      safety_k_position:=20
      attach_tool:=true
      tool_xyz:='0 0 0'
      tool_rpy:='1.57 0 0'
      reverse_port:=50001
      script_sender_port:=50002
      trajectory_port:=50003
      script_command_port:=50004">

    <link name="${name}_base_mount" />
    <joint name="${name}_base_mount_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${name}_base_mount" />
      <origin xyz="${xyz}" rpy="${rpy}" />
    </joint>

    <xacro:ur_robot
      name="${name}"
      tf_prefix="${tf_prefix}"
      parent="${name}_base_mount"
      joint_limits_parameters_file="$(find ur_description)/config/${ur_type}/joint_limits.yaml"
      kinematics_parameters_file="$(find ur_description)/config/${ur_type}/default_kinematics.yaml"
      physical_parameters_file="$(find ur_description)/config/${ur_type}/physical_parameters.yaml"
      visual_parameters_file="$(find ur_description)/config/${ur_type}/visual_parameters.yaml"
      safety_limits="${safety_limits}"
      safety_pos_margin="${safety_pos_margin}"
      safety_k_position="${safety_k_position}"
      use_fake_hardware="${use_fake_hardware}"
      sim_ignition="${sim_ignition}"
      headless_mode="${headless_mode}"
      robot_ip="${robot_ip}"
      reverse_port="${reverse_port}"
      script_sender_port="${script_sender_port}"
      trajectory_port="${trajectory_port}"
      script_command_port="${script_command_port}"
      script_filename="to_be_filled_by_ur_robot_driver"
      output_recipe_filename="to_be_filled_by_ur_robot_driver"
      input_recipe_filename="to_be_filled_by_ur_robot_driver"
      generate_ros2_control_tag="${str(sim_ignition).lower() != 'true'}">
      <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:ur_robot>
    <!-- En Gazebo el <ros2_control> lo arma ur_sim_ros2_control (abajo) en
         vez de ur_description, para poder declarar el sensor F/T. -->
    <xacro:property name="_is_sim" value="${str(sim_ignition).lower() == 'true'}" />

    <xacro:if value="${attach_tool}">
      <xacro:tool
        parent_link="${tf_prefix}tool0"
        tf_prefix="${tf_prefix}"
        xyz="${tool_xyz}"
        rpy="${tool_rpy}" />
    </xacro:if>

    <!-- Gazebo: el plugin crea el controller_manager de ESTE robot dentro
         del simulador, en el namespace /<name> (mismo que usa el launch),
         y lee robot_description de /<name>/robot_state_publisher. -->
    <xacro:if value="${_is_sim}">
      <gazebo>
        <plugin filename="libign_ros2_control-system.so"
                name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <parameters>${simulation_controllers}</parameters>
          <ros>
            <namespace>/${name}</namespace>
          </ros>
        </plugin>
      </gazebo>

      <xacro:ur_sim_ros2_control name="${name}" tf_prefix="${tf_prefix}" />

      <!-- Sensor F/T del TCP, como el del UR e-Series: en el joint
           flange -> tool0, medido en el frame de tool0 (el driver real
           publica la fuerza en el frame del TCP; con TCP nulo en el
           pendant eso es tool0). child_to_parent = fuerza que el lado de la
           herramienta ejerce sobre la brida: con la herramienta quieta es
           la fuerza externa + su peso (como un payload sin compensar).
           preserveFixedJoint: si no, Gazebo fusiona los joints fijos y el
           sensor desaparece con el joint. Se llama igual que el <sensor>
           de ur_sim_ros2_control, que es como IgnitionSystem lo asocia. -->
      <gazebo reference="${tf_prefix}flange-tool0">
        <preserveFixedJoint>true</preserveFixedJoint>
        <sensor name="${tf_prefix}tcp_fts_sensor" type="force_torque">
          <always_on>true</always_on>
          <update_rate>500</update_rate>
          <topic>/${name}/tcp_fts</topic>
          <force_torque>
            <frame>child</frame>
            <measure_direction>child_to_parent</measure_direction>
          </force_torque>
        </sensor>
      </gazebo>
    </xacro:if>

  </xacro:macro>
</robot>
