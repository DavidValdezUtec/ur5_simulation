/* Modern QSS for PyQt5 interface */

QWidget {
	background-color: #23272e;
	color: #e6e6e6;
	font-family: 'Segoe UI', 'Roboto', 'Arial', sans-serif;
	font-size: 15px;
}

QPushButton {
	background-color: #3a3f4b;
	color: #e6e6e6;
	border: none;
	border-radius: 6px;
	padding: 8px 16px;
	font-weight: 500;
	transition: background 0.2s;
}
QPushButton:hover {
	background-color: #4f5668;
}
QPushButton:pressed {
	background-color: #2d313a;
}

QLabel {
	color: #e6e6e6;
}

QTabWidget::pane {
	border: 1px solid #444a58;
	border-radius: 8px;
	background: #23272e;
}
QTabBar::tab {
	background: #2d313a;
	color: #e6e6e6;
	border: none;
	border-radius: 6px 6px 0 0;
	min-width: 100px;
	padding: 8px 12px;
	margin-right: 2px;
}
QTabBar::tab:selected {
	background: #3a3f4b;
	color: #00bfff;
}
QTabBar::tab:hover {
	background: #4f5668;
}

QLineEdit, QComboBox {
	background: #2d313a;
	color: #e6e6e6;
	border: 1px solid #444a58;
	border-radius: 6px;
	padding: 6px;
}

QScrollArea {
	border: none;
	background: #23272e;
}

QSlider::groove:horizontal {
	border: 1px solid #444a58;
	height: 8px;
	background: #2d313a;
	border-radius: 4px;
}
QSlider::handle:horizontal {
	background: #00bfff;
	border: 1px solid #444a58;
	width: 18px;
	height: 18px;
	margin: -5px 0;
	border-radius: 9px;
}

QDockWidget {
	background: #23272e;
}



/* Estilos específicos para los tabs verticales con iconos en QTabWidget con objectName 'menu_general' */
QTabWidget#menu_general > QTabBar::tab {
	min-width: 40px;
	min-height: 40px;
	max-height: 40px;
	max-width: 40px;
	padding: 4px;
	margin: 4px 4px 4px 4px;
	background: #2d313a;
	border: none;
}
QTabWidget#menu_general > QTabBar::tab:selected {
	background: #00bfff;
	color: #23272e;
}
QTabWidget#menu_general > QTabBar::tab:hover {
	background: #4f5668;
}
QTabWidget#menu_general > QTabBar {
	qproperty-drawBase: 0;
}
